CompileFlags:
  # 1. Remove NVCC-specific flags that Clang doesn't understand
  Remove: 
    - -forward-unknown-to-host-compiler
    - -gencode*
    - --generate-code*
    - --options-file*
    - -Xcompiler*
    - --compiler-options*
    - -ccbin*
    - -restrict
    - --expt-extended-lambda
    - -rdc*
  Add:
    - -xcuda
    - --cuda-path=/usr/local/cuda
    - -std=c++17  # Ensure this matches your project's standard